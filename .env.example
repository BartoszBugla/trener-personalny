
# --- Sign-in (Firebase Authentication) ---------------------------------------
# Bootstrap admins: comma-separated emails and/or "@domain" entries that can
# always sign in. Add everyone else in the app (App users / Clients → Give access).
AUTH_ALLOWED_EMAILS=""
# Session length in days (1–14)
# AUTH_SESSION_DAYS="5"

# Firebase Admin – console → Project settings → Service accounts →
# "Generate new private key"; copy project_id, client_email, private_key.
# Keep the key on one line with \n escapes, in double quotes.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
# Alternative: GOOGLE_APPLICATION_CREDENTIALS="/path/to/service-account.json"

# Client-exposed vars must be prefixed with VITE_
# VITE_APP_TITLE="Trener Personalny"

# Firebase web app – console → Project settings → General → Your apps (</>).
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_APP_ID=""
