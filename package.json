    "better-sqlite3": "^12.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "drizzle-kit": "^0.31.9",
    "drizzle-orm": "^0.45.1",
    "firebase": "^13.2.0",
    "firebase-admin": "^14.5.0",
    "i18next": "^27.0.1",
    "ical.js": "^2.2.1",
    "inversify": "^8.3.0",
